# ==============================================================================
# SIVORA AI E-Commerce - Docker Compose Environment Configuration (Day 23)
# Loaded automatically by Docker Compose for containerized stack
# ==============================================================================

# Database Secrets & Networking
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# Redis Cache & Celery Networking
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Backend API
BACKEND_PORT=8000
SECRET_KEY=sivora-enterprise-production-jwt-token-signing-key-32chars
ENVIRONMENT=production
DEBUG=False
USE_SQLITE_FALLBACK=False

# Frontend Port
FRONTEND_PORT=80

# External AI Provider Keys (Optional Free-tier)
GROQ_API_KEY=
GEMINI_API_KEY=
AI_FALLBACK_ORDER=groq,gemini,mock
