# ==============================================================================
# SIVORA AI E-Commerce - Environment Variable Template
# Copy this to .env (for local dev) or configure in GitHub Secrets / AWS Secrets Manager
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SIVORA Luxury AI E-Commerce Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite Dev: USE_SQLITE_FALLBACK=True
# Docker/Production: USE_SQLITE_FALLBACK=False, DB_HOST=postgres (or AWS RDS endpoint)
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH="ecommerce.db"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_secure_db_password"
DB_NAME="ecommerce_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_db_password"
POSTGRES_DB="ecommerce_db"

# Redis Cache & Broker Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20
REDIS_CART_TTL_SECONDS=604800
REDIS_CACHE_TTL_SECONDS=300

# Celery Background Processing
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-32-character-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Media Uploads & Vector Store
UPLOAD_DIR="uploads"

# AI Provider API Keys (Zero-Cost Free Tier)
GROQ_API_KEY=""
GEMINI_API_KEY=""
AI_FALLBACK_ORDER="groq,gemini,mock"
