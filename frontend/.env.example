# Sivora Frontend Environment Variables
# For Vercel production deployment, set VITE_API_URL in the Vercel Dashboard Project Settings:
# Environment Variables -> Key: VITE_API_URL, Value: https://<your-render-backend-url>.onrender.com

VITE_API_URL=https://sivoraa-backend.onrender.com
# Optional: WebSocket URL override (automatically derived from VITE_API_URL if omitted)
# VITE_WS_URL=wss://sivoraa-backend.onrender.com/ws
